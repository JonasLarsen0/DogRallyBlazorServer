{
  "name": "rejseplan-dashboard",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test": "svelte-kit sync && vitest run --config vitest.config.ts",
    "test:watch": "svelte-kit sync && vitest --config vitest.config.ts"
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "^5.0.1",
    "@sveltejs/kit": "^2.5.7",
    "@testing-library/jest-dom": "^6.4.2",
    "@testing-library/svelte": "^5.1.0",
    "jsdom": "^24.1.0",
    "svelte": "^4.2.18",
    "svelte-check": "^3.8.0",
    "typescript": "^5.4.5",
    "vite": "^5.2.11",
    "vitest": "^1.6.0"
  },
  "dependencies": {
    "@sveltejs/vite-plugin-svelte": "^3.1.2"
  }
}
