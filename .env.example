# ── Rejseplanen API ──────────────────────────────────────────────────────────
#
# How to get an API key:
#   1. Register at https://help.rejseplanen.dk/hc/en-us/articles/214174465
#   2. You will receive credentials by email within a few business days.
#   3. Use the accessId (API key) you receive below.
#
# Quota: the free tier is sufficient for a personal dashboard polling every
# 30 seconds (≈ 2880 requests/day). If you see repeated 429 errors in logs,
# increase POLL_INTERVAL_SECONDS or contact Rejseplanen to raise your quota.
REJSEPLANEN_API_KEY=your_api_key_here

# ── Backend settings ─────────────────────────────────────────────────────────
#
# How often the backend polls Rejseplanen for new departure data (seconds).
# Minimum: 5. Be respectful of your API quota — 30 is a good default.
POLL_INTERVAL_SECONDS=30

# CORS — which browser origins are allowed to call the API.
# Use "*" during development. In production, restrict to your dashboard URL,
# e.g.: CORS_ORIGINS=http://192.168.1.50,https://rejseplan.yourdomain.com
CORS_ORIGINS=*

# ── Default favourite stops ───────────────────────────────────────────────────
#
# Comma-separated Rejseplanen stop IDs to watch when the backend starts.
# Find stop IDs at runtime: GET http://your-server/api/stops/search?q=Odense
#
# Common stops:
#   Odense St.       = 8600020
#   Nyborg St.       = 8600254
#   Svendborg St.    = 8600868
#   København H      = 8600626
#   Aarhus H         = 8600053
#
# You can also update watched stops at runtime without a restart via:
#   POST /api/config  {"stop_ids": ["8600020", "8600254"], "walk_time_seconds": 300}
DEFAULT_STOP_IDS=8600020,8600254

# ── Vehicle filter ────────────────────────────────────────────────────────────
# true  = only trains (IC, RE, S-tog, ICE, EC etc.) — suppresses bus, metro, ferry
# false = show all transport types
TRAIN_ONLY=true

# ── "Go Now" alert threshold ─────────────────────────────────────────────────
# How many seconds of walk time to the stop (default: 5 minutes = 300 seconds).
# The dashboard shows a full-screen alert when a departure is within this window.
# The Home Assistant "go_now" binary sensor uses a per-integration setting (minutes),
# but this value is the backend default used by the WebSocket broadcast and
# POST /api/config when no explicit value is given.
WALK_TIME_SECONDS=300
