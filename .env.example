# ── Rejseplanen API ──────────────────────────────────────────────────────────
REJSEPLANEN_API_KEY=your_api_key_here

# ── Backend settings ─────────────────────────────────────────────────────────
POLL_INTERVAL_SECONDS=30
CORS_ORIGINS=*

# ── Default favourite stops ───────────────────────────────────────────────────
# Comma-separated Rejseplanen stop IDs.
# Find stop IDs by searching: http://your-server/api/stops/search?q=Nørreport
FAVORITE_STOP_IDS=

# ── "Go Now" alert threshold ─────────────────────────────────────────────────
# How many seconds of walk time to the stop (default: 5 minutes)
WALK_TIME_SECONDS=300
