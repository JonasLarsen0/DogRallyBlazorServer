# ── Rejseplanen API ──────────────────────────────────────────────────────────
REJSEPLANEN_API_KEY=your_api_key_here

# ── Backend settings ─────────────────────────────────────────────────────────
POLL_INTERVAL_SECONDS=30
CORS_ORIGINS=*

# ── Default favourite stops ───────────────────────────────────────────────────
# Comma-separated Rejseplanen stop IDs.
# Find stop IDs at runtime: GET http://your-server/api/stops/search?q=Odense
# Common stops: Odense St.=8600020  Nyborg St.=8600254  København H=8600626
DEFAULT_STOP_IDS=8600020,8600254

# ── Vehicle filter ────────────────────────────────────────────────────────────
# true  = only trains (IC, RE, S-tog, ICE etc.) — suppresses bus, metro, ferry
# false = show all transport types
TRAIN_ONLY=true

# ── "Go Now" alert threshold ─────────────────────────────────────────────────
# How many seconds of walk time to the stop (default: 5 minutes)
WALK_TIME_SECONDS=300
