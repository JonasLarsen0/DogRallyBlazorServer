# Copy this file to .env and fill in your values.

# Rejseplanen API key (required)
REJSEPLANEN_API_KEY=your_api_key_here

# Stop IDs to watch on startup, comma-separated (optional)
# Find IDs with GET /api/stops/search?q=<name>
DEFAULT_STOP_IDS=8600626,8600868

# How often to poll Rejseplanen (seconds, min 5)
POLL_INTERVAL_SECONDS=30

# Walk time used to compute go_now flag (seconds)
WALK_TIME_SECONDS=300

# CORS — use "*" for development, restrict in production
CORS_ORIGINS=*

# Uvicorn bind settings
HOST=0.0.0.0
PORT=8000
